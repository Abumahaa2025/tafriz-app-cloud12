# انسخ هذا الملف إلى .env عند التطوير محليًا، أو أضف نفس المتغيرات في إعدادات
# الاستضافة (Vercel ▸ Settings ▸ Environment Variables) قبل النشر.
#
# ملف .env مستبعَد في .gitignore — لا ترفعه أبدًا. لا تكتب أي مفتاح داخل الكود.
#
# ⚠️ قاعدة واحدة تحسم الأمان هنا: أي متغير يبدأ بـ VITE_ يُستبدل نصًّا داخل
#    حزمة الجافاسكربت وقت البناء، فيصير مقروءًا لأي شخص يفتح الموقع.
#    ضع في VITE_ المفاتيح العامة فقط. أي سر → بدون بادئة VITE_.
#
# تفاصيل نموذج الأمان كاملًا في docs/SECURITY.md


# ---------------------------------------------------------------------------
# عام — يقرأه المتصفح (كشفه ليس ثغرة، الحماية من RLS داخل قاعدة البيانات)
# ---------------------------------------------------------------------------
# من مشروعك على supabase.com ▸ Project Settings ▸ API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# DSN من Sentry ▸ Project Settings ▸ Client Keys (DSN)
# عام ومصمَّم للواجهة — بدونه تُتخطّى مراقبة Sentry ويبقى التطبيق يعمل.
# ⚠️ هذا مشروع Vite: استخدم VITE_SENTRY_DSN وليس NEXT_PUBLIC_SENTRY_DSN.
VITE_SENTRY_DSN=


# ---------------------------------------------------------------------------
# سري — الخادم فقط. لا تضعه في أي متغير يبدأ بـ VITE_
# ---------------------------------------------------------------------------
# مفتاح service_role من Supabase ▸ Project Settings ▸ API.
# يتجاوز RLS بالكامل — من يحصل عليه يقرأ ويعدّل كل بيانات المشتركين.
# يلزم حتى يعمل /api/auth-register بدون إيميلات تأكيد.
SUPABASE_SERVICE_ROLE_KEY=

# نفس قيمة VITE_SUPABASE_URL. اختياري — يرجع لـ VITE_SUPABASE_URL إن تُرك فارغًا.
SUPABASE_URL=

# مفتاح API من https://console.anthropic.com لقراءة اللوحات بالذكاء.
# اختياري: بدونه تتعطّل هذه الميزة وحدها ويبقى باقي التطبيق يعمل.
ANTHROPIC_API_KEY=

# مفتاح API من https://aistudio.google.com/apikey لربط الخرائط والتتبع
# عبر Gemini مع أداة google_maps (Grounding with Google Maps).
# اختياري: بدونه تتعطّل /api/maps-assist وحدها ويبقى باقي التطبيق يعمل.
# ⚠️ لا تضعه في متغيّر يبدأ بـ VITE_ — يبقى على الخادم فقط.
GEMINI_API_KEY=


# ---------------------------------------------------------------------------
# إعدادات غير سرية
# ---------------------------------------------------------------------------
# حساب المالك على الخادم. لازم يطابق OWNER_IDENTIFIER في src/lib/owner-config.ts
# اختياري — الافتراضي 0575051487
OWNER_IDENTIFIER=
