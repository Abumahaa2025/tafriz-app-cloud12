# انسخ هذا الملف إلى .env عند التطوير محليًا، أو أضف نفس المتغير في إعدادات
# الاستضافة (Vercel ▸ Settings ▸ Environment Variables) قبل النشر.
# مفتاح API من https://console.anthropic.com — لا ترفعه أبدًا لمستودع عام.
ANTHROPIC_API_KEY=

# قاعدة بيانات المستخدمين الحقيقية (المشتركون، الملاحظات، رموز التفعيل،
# سجل الفرز، الملفات المرفوعة) — من مشروعك على supabase.com ▸ Settings ▸
# API. لازم تبدأ بـ VITE_ حتى يقدر المتصفح يقرأها (متغيرات عامة، آمنة
# للكشف، مو أسرار — الحماية الحقيقية من RLS في قاعدة البيانات نفسها).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# مفتاح service_role من Supabase ▸ Project Settings ▸ API (سري — للخادم فقط)
# يُضاف في Vercel Environment Variables باسم SUPABASE_SERVICE_ROLE_KEY
# حتى يعمل /api/auth-register بدون إيميلات تأكيد.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
